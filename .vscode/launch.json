{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Debug: MCP Server + Workshop App",
            "configurations": [
                "Debug: MCP Sales Server",
                "Debug: Workshop Sales Assistant"
            ],
            "stopAll": true
        }
    ],
    "configurations": [
        {
            "name": "Debug: Workshop Sales Assistant",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/python/workshop/app.py",
            "console": "integratedTerminal",
            "args": [],
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": true
        },
        {
            "name": "Debug: MCP Sales Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/python/mcp/mcp_server.py",
            "console": "integratedTerminal",
            "args": [],
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": true
        }
    ]
}