{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Debug: MCP Server + Agent Service + Web App",
            "configurations": [
                "Debug: MCP Sales Server",
                "Debug: Agent Service", 
                "Debug: Web App"
            ],
            "stopAll": true
        },
    ],
    "configurations": [
        {
            "name": "Debug: Agent Service",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/python/workshop/agent_service.py",
            "console": "integratedTerminal",
            "args": [],
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": true
        },
        {
            "name": "Debug: Web App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/python/web_app/web_app.py",
            "console": "integratedTerminal",
            "args": [],
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": true
        },
        {
            "name": "Debug: MCP Sales Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/python/mcp_server/mcp_server.py",
            "console": "integratedTerminal",
            "args": [],
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": true
        }
    ]
}